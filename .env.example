# 이 파일을 .env 로 복사해서 값을 채우세요.
# 채널/길드/역할 ID는 여기 없음 → config/guilds.js 에서 관리(비밀 아님, git 커밋됨).
# 서버(길드) 추가는 config/guilds.js 에 객체 하나만 추가하면 됩니다.

# 로컬=development, VM=production
NODE_ENV=development

# 디스코드 봇 토큰 (환경별로 다른 봇을 쓸 수 있음)
TOKEN=

# 봇의 유저 ID (Application ID)
BOT_ID=

# 넥슨 오픈 API 키 (https://openapi.nexon.com)
NEXON_API_KEY=

# 명령어 사용량 기록의 '하루 사용자 수'용 비밀 소금(아무 긴 무작위 문자열, 예: openssl rand -hex 32)
# 유저 ID를 이 값과 섞어 해시한 앞 10글자만 당일에 잠깐 두고, 날이 바뀌면 지운다(ID 원문은 저장 안 함).
# 비워 두면 사용자 수 집계만 꺼지고 횟수·에러·시간 기록은 그대로 된다. 한 번 정하면 바꾸지 않는 것을 권장.
USAGE_SALT=
