# addon_server/.env 로 복사해서 채우세요 (권한 600: chmod 600 .env). 봇의 .env와 별개 파일입니다.

# 디스코드 개발자 포털 > OAuth2 (앱의 discord_auth.py CLIENT_ID와 같은 애플리케이션)
DISCORD_CLIENT_ID=1172437289339727913
DISCORD_CLIENT_SECRET=

# 외부 주소(Caddy). 디스코드 Redirect = PUBLIC_BASE_URL + /auth/callback
PUBLIC_BASE_URL=https://starline-bot.duckdns.org

# 앱 토큰 서명 비밀 키(Ed25519 seed, base64). 만들기: .venv/bin/python scripts/genkey.py
# 공개 키는 genkey.py가 함께 출력 → 앱 코드에 넣는다. 비밀 키는 이 파일에만.
TOKEN_SIGNING_KEY=

# 제작자(creator 등급) 디스코드 ID, 쉼표로 여러 명
CREATOR_IDS=280290004926857216

# (선택) 기본값
# DATA_DIR=data
# TOKEN_TTL_DAYS=30
# MAX_SETTINGS_BYTES=2097152
# RATE_LIMIT_PER_MIN=60
