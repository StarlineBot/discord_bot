# 이 파일을 .env 로 복사해서 값을 채우세요.
# 채널/길드/역할 ID는 여기 없음 → config/guilds.js 에서 관리(비밀 아님, git 커밋됨).
# 서버(길드) 추가는 config/guilds.js 에 객체 하나만 추가하면 됩니다.

# 로컬=development, VM=production
NODE_ENV=development

# 디스코드 봇 토큰 (환경별로 다른 봇을 쓸 수 있음)
TOKEN=

# 봇의 유저 ID (Application ID)
BOT_ID=

# 넥슨 오픈 API 키 (https://openapi.nexon.com)
NEXON_API_KEY=
